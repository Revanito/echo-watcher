# All optional — docker-compose.yml already has sane defaults for every one of these.
# Copy to .env and uncomment/edit only what you want to change.

# Comma-separated hosts to ping. Include your router's LAN IP alongside public IPs to tell
# "my LAN is flaky" apart from "problem is upstream of my router" (ISP's problem).
# TARGETS=1.1.1.1,8.8.8.8,192.168.1.254

# Seconds between pings, per target.
# INTERVAL=1

# Seconds to wait for a reply before counting a timeout.
# PING_TIMEOUT=1

# Consecutive timeouts before an outage event opens.
# OUTAGE_FAILS=2

# Absolute latency (ms) that always counts as a spike.
# SPIKE_ABS_MS=150

# Latency above the rolling per-target baseline (ms) that counts as a spike.
# SPIKE_JITTER_MS=40

# Raw ping samples older than this are pruned every 6h. Outage/spike events are kept forever.
# RETENTION_DAYS=14
